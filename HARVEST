--HARVEST AIRIN s8 PROJECT
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Gardens = workspace:WaitForChild("Gardens")

--------------------------------------------------
-- CONFIG
--------------------------------------------------

-- Blacklist Fruit berdasarkan CorePartName
local BLACKLIST = {
    NAMEFRUIT = true,
}

-- Jika SizeMulti > nilai ini, buah akan menunggu mutasi
local SIZE_THRESHOLD = 8

-- Tunggu 1 menit sebelum mulai harvest
local START_DELAY = 60

--------------------------------------------------
-- FUNCTIONS
--------------------------------------------------

-- Cari plot milik player
local function GetMyPlot()
    for i = 1, 8 do
        local Plot = Gardens:FindFirstChild("Plot" .. i)

        if Plot and Plot:GetAttribute("Owner") == LocalPlayer.Name then
            return Plot
        end
    end

    return nil
end

--------------------------------------------------
-- WAIT 1 MINUTE BEFORE START
--------------------------------------------------

print("⏳ Harvest akan dimulai dalam 1 menit...")
task.wait(START_DELAY)
print("🚀 Waktu tunggu selesai, mulai harvest!")

--------------------------------------------------
-- LOOP
--------------------------------------------------

while task.wait(0) do
    local MyPlot = GetMyPlot()

    if not MyPlot then
        warn("❌ Plot milikmu tidak ditemukan!")
        continue
    end

    local Plants = MyPlot:FindFirstChild("Plants")

    if not Plants then
        warn("❌ Folder Plants tidak ditemukan!")
        continue
    end

    local harvested = 0

    for _, Plant in ipairs(Plants:GetChildren()) do

        --------------------------------------------------
        -- Harvest Plant
        --------------------------------------------------

        local HarvestPart = Plant:FindFirstChild("HarvestPart")

        if HarvestPart then
            local HarvestPrompt = HarvestPart:FindFirstChild("HarvestPrompt")

            if HarvestPrompt and HarvestPrompt:IsA("ProximityPrompt") then
                pcall(function()
                    fireproximityprompt(HarvestPrompt)
                end)

                harvested += 1
                task.wait(0.001)
            end
        end

        --------------------------------------------------
        -- Harvest Fruits
        -- Size <= SIZE_THRESHOLD  -> Langsung harvest
        -- Size >  SIZE_THRESHOLD  -> Tunggu sampai ada Mutation
        --------------------------------------------------

        local Fruits = Plant:FindFirstChild("Fruits")

        if Fruits then
            for _, Fruit in ipairs(Fruits:GetChildren()) do

                local SizeMulti = Fruit:GetAttribute("SizeMulti") or 1
                local Mutation = Fruit:GetAttribute("Mutation")

                -- Jika buah besar tapi belum mutasi, skip
                if SizeMulti > SIZE_THRESHOLD and not Mutation then
                    continue
                end

                local CorePartName = Fruit:GetAttribute("CorePartName")

                if BLACKLIST[CorePartName] then
                    continue
                end

                local FruitHarvestPart = Fruit:FindFirstChild("HarvestPart")

                if FruitHarvestPart then
                    local FruitPrompt = FruitHarvestPart:FindFirstChild("HarvestPrompt")

                    if FruitPrompt and FruitPrompt:IsA("ProximityPrompt") then
                        pcall(function()
                            fireproximityprompt(FruitPrompt)
                        end)

                        harvested += 1
                        task.wait(0.001)
                    end
                end
            end
        end
    end

    print(string.format(
        "✅ [%s] Harvest selesai | Plants: %d | Total Harvest: %d",
        MyPlot.Name,
        #Plants:GetChildren(),
        harvested
    ))
end
