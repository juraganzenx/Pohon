-- SELL FRUIT LOOP
-- FAVORITE SIZE MULTIPLIER > 8
-- SELL ALL
-- UNFAVORITE KEMBALI
-- ULANGI TERUS

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Networking = require(ReplicatedStorage.SharedModules.Networking)

local Backpack = LocalPlayer:WaitForChild("Backpack")

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local SIZE_MULTIPLIER_LIMIT = 8

local FAVORITE_DELAY = 0.05
local BEFORE_SELL_DELAY = 1
local AFTER_SELL_DELAY = 1
local UNFAVORITE_DELAY = 0.05

local LOOP_DELAY = 2

--------------------------------------------------
-- DAFTAR FRUIT YANG DI-FAVORITE
-- PADA SETIAP SIKLUS
--------------------------------------------------

local FavoritedFruits = {}

--------------------------------------------------
-- FAVORITE SEMUA FRUIT SIZE MULTIPLIER > 8
--------------------------------------------------

local function FavoriteBigFruits()

    local count = 0

    -- Bersihkan daftar siklus sebelumnya
    table.clear(FavoritedFruits)

    for _, Fruit in ipairs(Backpack:GetChildren()) do

        local FruitId = Fruit:GetAttribute("Id")
        local SizeMultiplier = Fruit:GetAttribute("SizeMultiplier")

        if FruitId
            and SizeMultiplier
            and SizeMultiplier > SIZE_MULTIPLIER_LIMIT
        then

            Networking.Backpack.SetFruitFavorite:Fire(
                FruitId,
                true
            )

            -- Simpan ID untuk di-unfavorite setelah SellAll
            FavoritedFruits[FruitId] = true

            count += 1

            task.wait(FAVORITE_DELAY)
        end
    end

    print(
        "[SELL LOOP] Favorite:",
        count,
        "fruit dengan SizeMultiplier >",
        SIZE_MULTIPLIER_LIMIT
    )
end

--------------------------------------------------
-- SELL ALL
--------------------------------------------------

local function SellAll()

    print("[SELL LOOP] PreviewSellAll")

    Networking.NPCS.PreviewSellAll:Fire()

    task.wait(BEFORE_SELL_DELAY)

    print("[SELL LOOP] SellAll")

    Networking.NPCS.SellAll:Fire()

end

--------------------------------------------------
-- UNFAVORITE FRUIT YANG TADI DI-FAVORITE
--------------------------------------------------

local function UnfavoriteBigFruits()

    local count = 0

    for FruitId in pairs(FavoritedFruits) do

        Networking.Backpack.SetFruitFavorite:Fire(
            FruitId,
            false
        )

        count += 1

        task.wait(UNFAVORITE_DELAY)
    end

    print(
        "[SELL LOOP] Unfavorite:",
        count,
        "fruit"
    )

    table.clear(FavoritedFruits)

end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

while true do

    print("==============================")
    print("[SELL LOOP] START CYCLE")
    print("==============================")

    --------------------------------------------------
    -- 1. FAVORITE FRUIT > 8
    --------------------------------------------------

    FavoriteBigFruits()

    --------------------------------------------------
    -- 2. TUNGGU REQUEST FAVORITE
    --------------------------------------------------

    task.wait(BEFORE_SELL_DELAY)

    --------------------------------------------------
    -- 3. SELL ALL
    --------------------------------------------------

    SellAll()

    --------------------------------------------------
    -- 4. TUNGGU SELL SELESAI
    --------------------------------------------------

    task.wait(AFTER_SELL_DELAY)

    --------------------------------------------------
    -- 5. UNFAVORITE KEMBALI
    --------------------------------------------------

    UnfavoriteBigFruits()

    --------------------------------------------------
    -- 6. TUNGGU SEBELUM LOOP BERIKUTNYA
    --------------------------------------------------

    print("[SELL LOOP] CYCLE SELESAI")

    task.wait(LOOP_DELAY)

end
