--==================================================
-- ADD PLAYER
--==================================================

local function AddPlayer(
    Username
)

    if not Username
        or Username == "" then

        return

    end


    Username =
        tostring(
            Username
        )


    for _, Existing in ipairs(
        TARGET_USERNAMES
    ) do

        if Existing:lower()
            == Username:lower()
        then

            return

        end

    end


    table.insert(
        TARGET_USERNAMES,
        Username
    )


    History[Username] = {

        Status =
            "Belum kirim",

        Value = 0

    }


    SavePlayers()

    SaveHistory()

    RefreshHistoryGUI()

end


