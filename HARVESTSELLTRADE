--==================================================
-- SEND TO TARGET
--==================================================

local function SendToTarget(
    TargetUsername
)

    SetStep(
        "Getting UserId: "
        .. TargetUsername
    )

    local SuccessUserId,
        TargetUserId =
        pcall(function()

            return Players:GetUserIdFromNameAsync(
                TargetUsername
            )

        end)

    if not SuccessUserId
        or not TargetUserId then

        warn(
            "UserId gagal:",
            TargetUsername
        )

        return false

    end

    if not Running then
        return false
    end

    SetStep(
        "Building Trade Batch"
    )

    local Batch,
        TotalValue =
        BuildBatch()

    if #Batch == 0 then

        warn(
            "Batch kosong"
        )

        return false

    end

    SetStep(
        "Sending "
        .. #Batch
        .. " Fruit -> "
        .. TargetUsername
    )

    local SuccessSend =
        pcall(function()

            Networking.Mailbox
                .SendBatch
                :Fire(
                    TargetUserId,
                    Batch,
                    NOTE
                )

        end)

    if not SuccessSend then

        warn(
            "[AUTO SEND] Send gagal:",
            TargetUsername
        )

        return false

    end

    --==================================================
    -- SAVE VALUE
    --==================================================

    History[
        TargetUsername
    ] = {

        Status =
            "Sudah kirim",

        Value =
            TotalValue

    }

    SaveHistory()

    RefreshHistoryGUI()

    print(
        "[AUTO SEND] SUCCESS",
        TargetUsername,
        "Value:",
        TotalValue
    )

    return true

end

--==================================================
-- AUTO SEND
--==================================================

local function RunAutoSend()

    local TargetUsername =
        GetNextTarget()

    --==================================================
    -- ALL PLAYER SENT
    --==================================================

    if not TargetUsername then

        SetStep(
            "All Players Sent - Resetting"
        )

        task.wait(
            1
        )

        ResetHistory()

        TargetUsername =
            GetNextTarget()

    end

    if not TargetUsername then
        return
    end

    SetStep(
        "Checking Fruit -> "
        .. TargetUsername
    )

    local FruitCount =
        CountFruits()

    if FruitCount <
        MAX_FRUIT_SEND then

        SetStep(
            "Waiting Fruit: "
            .. FruitCount
            .. "/"
            .. MAX_FRUIT_SEND
        )

        return

    end

    SendToTarget(
        TargetUsername
    )

end

