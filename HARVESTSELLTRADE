--==================================================
-- BUILD BATCH
--==================================================

local function BuildBatch()

    local Fruits =
        {}

    local Batch =
        {}

    local TotalValue =
        0


    for _, Item in ipairs(
        Backpack:GetChildren()
    ) do


        if Item:IsA(
            "Tool"
        )
        or Item:IsA(
            "Configuration"
        ) then


            local FruitName =
                Item:GetAttribute(
                    "FruitName"
                )


            if FruitName then


                local Success, Value =
                    pcall(
                        function()

                            return FruitValueCalc(
                                FruitName,

                                Item:GetAttribute(
                                    "SizeMultiplier"
                                ),

                                Item:GetAttribute(
                                    "Mutation"
                                ),

                                LocalPlayer,

                                Item:GetAttribute(
                                    "DecayAlpha"
                                )

                            )

                        end
                    )


                if Success
                    and Value then


                    local FruitId =

                        Item:GetAttribute(
                            "FruitId"
                        )

                        or

                        Item:GetAttribute(
                            "ItemId"
                        )

                        or

                        Item:GetAttribute(
                            "UUID"
                        )

                        or

                        Item:GetAttribute(
                            "Id"
                        )


                    if FruitId then

                        table.insert(
                            Fruits,
                            {

                                Item =
                                    Item,

                                Value =
                                    Value,

                                FruitId =
                                    FruitId

                            }
                        )

                    end

                end

            end

        end

    end


    table.sort(
        Fruits,

        function(
            A,
            B
        )

            return A.Value >
                B.Value

        end
    )


    for _, Data in ipairs(
        Fruits
    ) do


        if #Batch >=
            MAX_FRUIT_SEND then

            break

        end


        if TotalValue >=
            TARGET_VALUE then

            break

        end


        table.insert(
            Batch,

            {

                Category =
                    "HarvestedFruits",

                ItemKey =
                    Data.FruitId,

                Count =
                    1

            }
        )


        TotalValue +=
            Data.Value

    end


    return Batch,
        TotalValue

end


