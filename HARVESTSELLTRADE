--==================================================
-- HARVEST
--==================================================

local function HarvestFruits()

    local MyPlot =
        GetMyPlot()

    if not MyPlot then

        warn(
            "Plot tidak ditemukan"
        )

        return 0

    end

    local Plants =
        MyPlot:FindFirstChild(
            "Plants"
        )

    if not Plants then
        return 0
    end

    local Harvested =
        0

    for _, Plant in ipairs(
        Plants:GetChildren()
    ) do

        --==================================================
        -- HARVEST PLANT
        --==================================================

        local HarvestPart =
            Plant:FindFirstChild(
                "HarvestPart"
            )

        if HarvestPart then

            local Prompt =
                HarvestPart:FindFirstChild(
                    "HarvestPrompt"
                )

            if Prompt
                and Prompt:IsA(
                    "ProximityPrompt"
                ) then

                pcall(function()

                    fireproximityprompt(
                        Prompt
                    )

                end)

                Harvested += 1

                task.wait(
                    0.001
                )

            end

        end

        --==================================================
        -- HARVEST FRUITS
        --==================================================

        local Fruits =
            Plant:FindFirstChild(
                "Fruits"
            )

        if Fruits then

            for _, Fruit in ipairs(
                Fruits:GetChildren()
            ) do

                local SizeMulti =
                    Fruit:GetAttribute(
                        "SizeMulti"
                    )
                    or 1

                local Mutation =
                    Fruit:GetAttribute(
                        "Mutation"
                    )

                if SizeMulti >
                    SIZE_THRESHOLD
                    and not Mutation then

                    continue

                end

                local CorePartName =
                    Fruit:GetAttribute(
                        "CorePartName"
                    )

                if BLACKLIST[
                    CorePartName
                ] then

                    continue

                end

                local FruitHarvestPart =
                    Fruit:FindFirstChild(
                        "HarvestPart"
                    )

                if FruitHarvestPart then

                    local Prompt =
                        FruitHarvestPart:FindFirstChild(
                            "HarvestPrompt"
                        )

                    if Prompt
                        and Prompt:IsA(
                            "ProximityPrompt"
                        ) then

                        pcall(function()

                            fireproximityprompt(
                                Prompt
                            )

                        end)

                        Harvested += 1

                        task.wait(
                            0.001
                        )

                    end

                end

            end

        end

    end

    return Harvested

end

