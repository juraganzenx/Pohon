--==================================================
-- ADD PLAYER
--==================================================

local function AddPlayer(
    Username
)

    if not Username
        or Username == "" then

        return

    end

    Username =
        tostring(
            Username
        )

    for _, Existing in ipairs(
        TARGET_USERNAMES
    ) do

        if Existing:lower()
            == Username:lower() then

            return

        end

    end

    table.insert(
        TARGET_USERNAMES,
        Username
    )

    History[Username] = {
        Status = "Belum kirim",
        Value = 0
    }

    SaveHistory()

    RefreshHistoryGUI()

    print(
        "[GUI] Added player:",
        Username
    )

end

--==================================================
-- REMOVE PLAYER
--==================================================

local function RemovePlayer(
    Username
)

    if not Username
        or Username == "" then

        return

    end

    for Index, Existing in ipairs(
        TARGET_USERNAMES
    ) do

        if Existing:lower()
            == Username:lower() then

            table.remove(
                TARGET_USERNAMES,
                Index
            )

            History[Existing] =
                nil

            SaveHistory()

            RefreshHistoryGUI()

            print(
                "[GUI] Removed player:",
                Existing
            )

            return

        end

    end

end

