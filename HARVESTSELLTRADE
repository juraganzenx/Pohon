--------------------------------------------------
-- HARVEST
--------------------------------------------------

local function HarvestFruits()

    if ShouldStop() then

        return 0

    end


    SetStatus(
        "🌱 HARVEST"
    )


    AddLog(
        "Memulai harvest..."
    )


    local MyPlot =
        GetMyPlot()


    if not MyPlot then

        AddLog(
            "❌ Plot tidak ditemukan"
        )

        return 0

    end


    local Plants =
        MyPlot:FindFirstChild(
            "Plants"
        )


    if not Plants then

        AddLog(
            "❌ Folder Plants tidak ditemukan"
        )

        return 0

    end


    local harvested =
        0


    for _, Plant in ipairs(
        Plants:GetChildren()
    ) do

        if ShouldStop() then

            break

        end


        --------------------------------------------------
        -- PLANT HARVEST
        --------------------------------------------------

        local HarvestPart =
            Plant:FindFirstChild(
                "HarvestPart"
            )


        if HarvestPart then

            local HarvestPrompt =
                HarvestPart:FindFirstChild(
                    "HarvestPrompt"
                )


            if HarvestPrompt
                and HarvestPrompt:IsA(
                    "ProximityPrompt"
                )
            then

                pcall(
                    function()

                        fireproximityprompt(
                            HarvestPrompt
                        )

                    end
                )


                harvested += 1


                task.wait(
                    0.001
                )

            end

        end


        --------------------------------------------------
        -- FRUIT HARVEST
        --------------------------------------------------

        local Fruits =
            Plant:FindFirstChild(
                "Fruits"
            )


        if Fruits then

            for _, Fruit in ipairs(
                Fruits:GetChildren()
            ) do

                if ShouldStop() then

                    break

                end


                local SizeMulti =
                    Fruit:GetAttribute(
                        "SizeMulti"
                    )
                    or 1


                local Mutation =
                    Fruit:GetAttribute(
                        "Mutation"
                    )


                if SizeMulti >
                    SIZE_THRESHOLD
                    and not Mutation
                then

                    continue

                end


                local CorePartName =
                    Fruit:GetAttribute(
                        "CorePartName"
                    )


                if BLACKLIST[
                    CorePartName
                ]
                then

                    continue

                end


                local FruitHarvestPart =
                    Fruit:FindFirstChild(
                        "HarvestPart"
                    )


                if FruitHarvestPart then

                    local FruitPrompt =
                        FruitHarvestPart:FindFirstChild(
                            "HarvestPrompt"
                        )


                    if FruitPrompt
                        and FruitPrompt:IsA(
                            "ProximityPrompt"
                        )
                    then

                        pcall(
                            function()

                                fireproximityprompt(
                                    FruitPrompt
                                )

                            end
                        )


                        harvested += 1


                        task.wait(
                            0.001
                        )

                    end

                end

            end

        end

    end


    LastHarvestCount =
        harvested


    UpdateInfo()


    AddLog(
        "🌱 Harvest selesai: "
        .. harvested
    )


    return harvested

end


