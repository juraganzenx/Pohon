--==================================================
-- FILE API
--==================================================

local function IsFileAPIAvailable()

    return
        isfile
        and readfile
        and writefile

end


--==================================================
-- SAVE PLAYER LIST
--==================================================

local function SavePlayers()

    if not IsFileAPIAvailable() then
        return false
    end

    local Success =
        pcall(
            function()

                writefile(
                    PLAYERS_FILE,
                    HttpService:JSONEncode(
                        TARGET_USERNAMES
                    )
                )

            end
        )

    return Success

end


--==================================================
-- LOAD PLAYER LIST
--==================================================

local function LoadPlayers()

    table.clear(TARGET_USERNAMES)

    for _, Username in ipairs(DEFAULT_USERNAMES) do
        table.insert(TARGET_USERNAMES, Username)
    end

end


