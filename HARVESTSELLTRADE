--------------------------------------------------
-- BUILD BATCH
--------------------------------------------------

local function BuildBatch()

    local Fruits =
        {}

    local Batch =
        {}

    local TotalValue =
        0


    for _, Item in ipairs(
        Backpack:GetChildren()
    ) do

        if Item:IsA("Tool")
            or Item:IsA(
                "Configuration"
            )
        then

            local FruitName =
                Item:GetAttribute(
                    "FruitName"
                )


            if FruitName then

                local Success,
                Value =
                    pcall(
                        function()

                            return FruitValueCalc(

                                FruitName,

                                Item:GetAttribute(
                                    "SizeMultiplier"
                                ),

                                Item:GetAttribute(
                                    "Mutation"
                                ),

                                LocalPlayer,

                                Item:GetAttribute(
                                    "DecayAlpha"
                                )

                            )

                        end
                    )


                if Success
                    and Value
                then

                    local FruitId =

                        Item:GetAttribute(
                            "FruitId"
                        )

                        or

                        Item:GetAttribute(
                            "ItemId"
                        )

                        or

                        Item:GetAttribute(
                            "UUID"
                        )

                        or

                        Item:GetAttribute(
                            "Id"
                        )


                    if FruitId then

                        table.insert(
                            Fruits,
                            {

                                Item =
                                    Item,

                                Value =
                                    Value,

                                FruitId =
                                    FruitId

                            }
                        )

                    end

                end

            end

        end

    end


    --------------------------------------------------
    -- SORT TERBESAR
    --------------------------------------------------

    table.sort(
        Fruits,

        function(
            A,
            B
        )

            return A.Value >
                B.Value

        end
    )


    --------------------------------------------------
    -- BUILD
    --------------------------------------------------

    for _, Data in ipairs(
        Fruits
    ) do

        if #Batch >=
            MAX_FRUIT_SEND
        then

            break

        end


        if TotalValue >=
            TARGET_VALUE
        then

            break

        end


        table.insert(
            Batch,

            {

                Category =
                    "HarvestedFruits",

                ItemKey =
                    Data.FruitId,

                Count =
                    1

            }
        )


        TotalValue +=
            Data.Value

    end


    return Batch,
        TotalValue

end


--------------------------------------------------
-- SEND TARGET
--------------------------------------------------

local function SendToTarget(
    TargetUsername
)

    if ShouldStop() then

        return false

    end


    CurrentTarget =
        TargetUsername


    SendLabel.Text =

        "AUTO SEND\n\n"

        .. "Target: "
        .. TargetUsername

        .. "\nStatus: Getting UserId..."

        .. "\nValue: 0"


    AddLog(
        "Target: "
        .. TargetUsername
    )


    --------------------------------------------------
    -- USER ID
    --------------------------------------------------

    local SuccessUserId,
    TargetUserId =
        pcall(
            function()

                return Players:GetUserIdFromNameAsync(
                    TargetUsername
                )

            end
        )


    if not SuccessUserId
        or not TargetUserId
    then

        AddLog(
            "❌ UserId gagal"
        )

        return false

    end


    --------------------------------------------------
    -- BUILD BATCH
    --------------------------------------------------

    local Batch,
    TotalValue =
        BuildBatch()


    LastSendCount =
        #Batch


    LastSendValue =
        TotalValue


    UpdateInfo()


    if #Batch == 0 then

        AddLog(
            "❌ Batch kosong"
        )

        return false

    end


    --------------------------------------------------
    -- SEND
    --------------------------------------------------

    SendLabel.Text =

        "AUTO SEND\n\n"

        .. "Target: "
        .. TargetUsername

        .. "\nStatus: Sending..."

        .. "\nFruit: "
        .. #Batch

        .. "\nValue: "
        .. FormatValue(
            TotalValue
        )


    AddLog(

        "📤 Sending "
        .. #Batch
        .. " fruit"

        .. " | Value: "
        .. FormatValue(
            TotalValue
        )

    )


    local SuccessSend =
        pcall(
            function()

                Networking.Mailbox.SendBatch:Fire(

                    TargetUserId,

                    Batch,

                    NOTE

                )

            end
        )


    if not SuccessSend then

        AddLog(
            "❌ Send gagal"
        )

        return false

    end


    --------------------------------------------------
    -- SUCCESS
    --------------------------------------------------

    AddLog(

        "✅ Berhasil dikirim ke "
        .. TargetUsername

    )


    SendLabel.Text =

        "AUTO SEND\n\n"

        .. "Target: "
        .. TargetUsername

        .. "\nStatus: ✅ Success"

        .. "\nFruit: "
        .. #Batch

        .. "\nValue: "
        .. FormatValue(
            TotalValue
        )


    return true

end


--------------------------------------------------
-- RUN AUTO SEND
--------------------------------------------------

local function RunAutoSend()

    if ShouldStop() then

        return

    end


    SetStatus(
        "📦 AUTO SEND"
    )


    local History =
        LoadHistory()


    if not History then

        AddLog(
            "❌ History gagal dimuat"
        )

        return

    end


    UpdateHistoryGUI(
        History
    )


    --------------------------------------------------
    -- RESET IF ALL SENT
    --------------------------------------------------

    if IsAllSent(
        History
    )
    then

        ResetHistoryStatus(
            History
        )

    end


    --------------------------------------------------
    -- GET TARGET
    --------------------------------------------------

    local TargetUsername =
        GetNextTarget(
            History
        )


    if not TargetUsername then

        AddLog(
            "⚠️ Tidak ada target"
        )

        return

    end


    CurrentTarget =
        TargetUsername


    --------------------------------------------------
    -- CHECK FRUIT
    --------------------------------------------------

    local FruitCount =
        GetFruitCount()


    UpdateInfo()


    AddLog(

        "Fruit tersedia: "
        .. FruitCount

    )


    if FruitCount <
        MAX_FRUIT_SEND
    then

        AddLog(

            "⏳ Fruit belum cukup"

            .. " | Butuh: "
            .. MAX_FRUIT_SEND

        )

        return

    end


    --------------------------------------------------
    -- SEND
    --------------------------------------------------

    local Success =
        SendToTarget(
            TargetUsername
        )


    --------------------------------------------------
    -- UPDATE HISTORY
    --------------------------------------------------

    if Success then

        History[
            TargetUsername
        ] = {

            Status =
                "Sudah kirim",

            Value =
                LastSendValue,

            FruitCount =
                LastSendCount

        }


        SaveHistory(
            History
        )


        UpdateHistoryGUI(
            History
        )


        AddLog(

            "📜 History updated"

            .. " | "
            .. TargetUsername

            .. " | Value: "
            .. FormatValue(
                LastSendValue
            )

        )

    end

end


--------------------------------------------------
-- RUN CYCLE
--------------------------------------------------

local function RunCycle()

    if ShouldStop() then

        return

    end


    Cycle += 1


    AddLog(
        "================================"
    )


    AddLog(
        "🔄 START CYCLE #"
        .. Cycle
    )


    --------------------------------------------------
    -- HARVEST
    --------------------------------------------------

    local HarvestedCount =
        HarvestFruits()


    if ShouldStop() then

        return

    end


    task.wait(
        AFTER_HARVEST_DELAY
    )


    --------------------------------------------------
    -- FAVORITE
    --------------------------------------------------

    local FavoritedCount =
        FavoriteBigFruits()


    if ShouldStop() then

        return

    end


    task.wait(
        BEFORE_SELL_DELAY
    )


    --------------------------------------------------
    -- SELL
    --------------------------------------------------

    SellAll()


    if ShouldStop() then

        return

    end


    task.wait(
        AFTER_SELL_DELAY
    )


    --------------------------------------------------
    -- UNFAVORITE
    --------------------------------------------------

    UnfavoriteBigFruits()


    if ShouldStop() then

        return

    end


    --------------------------------------------------
    -- AUTO SEND
    --------------------------------------------------

    RunAutoSend()


    --------------------------------------------------
    -- COMPLETE
    --------------------------------------------------

    LastHarvestCount =
        HarvestedCount


    LastFavoriteCount =
        FavoritedCount


    UpdateInfo()


    AddLog(

        "✅ CYCLE #"
        .. Cycle
        .. " SELESAI"

    )

end


--------------------------------------------------
-- START LOOP
--------------------------------------------------

local function StartLoop()

    if Running then

        AddLog(
            "⚠️ Sudah running"
        )

        return

    end


    Running =
        true


    SetStatus(
        "Starting..."
    )


    AddLog(
        "▶ AUTO START"
    )


    task.spawn(
        function()

            while Running do

                local Success,
                Error =
                    pcall(
                        function()

                            RunCycle()

                        end
                    )


                if not Success then

                    AddLog(

                        "❌ ERROR: "
                        .. tostring(
                            Error
                        )

                    )

                end


                if not Running then

                    break

                end


                SetStatus(
                    "⏳ WAIT NEXT CYCLE"
                )


                for i = 1,
                    LOOP_DELAY * 10
                do

                    if not Running then

                        break

                    end


                    task.wait(
                        0.1
                    )

                end

            end


            SetStatus(
                "Idle"
            )


            AddLog(
                "⏹ LOOP STOPPED"
            )

        end
    )

end


--------------------------------------------------
-- STOP LOOP
--------------------------------------------------

local function StopLoop()

    if not Running then

        AddLog(
            "⚠️ Sudah berhenti"
        )

        return

    end


    Running =
        false


    Status.Text =
        "🟡 STOPPING"


    Status.TextColor3 =
        Color3.fromRGB(
            255,
            200,
            80
        )


    AddLog(
        "⏹ Stop requested"
    )

end


--------------------------------------------------
-- ADD USERNAME
--------------------------------------------------

local function AddUsername(
    Username
)

    Username =
        tostring(
            Username or ""
        )


    Username =
        Username:match(
            "^%s*(.-)%s*$"
        )


    if Username == "" then

        AddLog(
            "❌ Username kosong"
        )

        return

    end


    local History =
        LoadHistory()


    if not History then

        return

    end


    if History[
        Username
    ] then

        AddLog(

            "⚠️ Username sudah ada: "
            .. Username

        )

        return

    end


    History[
        Username
    ] = {

        Status =
            "Belum kirim",

        Value =
            0,

        FruitCount =
            0

    }


    SaveHistory(
        History
    )


    UpdateHistoryGUI(
        History
    )


    AddLog(

        "➕ Username ditambahkan: "
        .. Username

    )

end


--------------------------------------------------
-- REMOVE USERNAME
--------------------------------------------------

local function RemoveUsername(
    Username
)

    local History =
        LoadHistory()


    if not History then

        return

    end


    if not History[
        Username
    ] then

        AddLog(

            "⚠️ Username tidak ditemukan: "
            .. Username

        )

        return

    end


    History[
        Username
    ] =
        nil


    SaveHistory(
        History
    )


    UpdateHistoryGUI(
        History
    )


    AddLog(

        "🗑 Username dihapus: "
        .. Username

    )

end


--------------------------------------------------
-- REFRESH REMOVE LIST
--------------------------------------------------

local function RefreshRemoveList()

    for _, Child in ipairs(
        RemoveScroll:GetChildren()
    ) do

        if Child:IsA(
            "TextButton"
        )
        then

            Child:Destroy()

        end

    end


    local History =
        LoadHistory()


    if not History then

        return

    end


    for Username in pairs(
        History
    ) do

        local Button =
            Instance.new(
                "TextButton"
            )


        Button.Size =
            UDim2.new(
                1,
                -10,
                0,
                28
            )


        Button.BackgroundColor3 =
            Color3.fromRGB(
                55,
                55,
                65
            )


        Button.Text =
            "🗑  "
            .. Username


        Button.TextColor3 =
            Color3.fromRGB(
                255,
                255,
                255
            )


        Button.TextSize =
            12


        Button.Font =
            Enum.Font.Gotham


        Button.ZIndex =
            22


        Button.Parent =
            RemoveScroll


        Button.MouseButton1Click:Connect(

            function()

                RemoveUsername(
                    Username
                )


                RefreshRemoveList()

            end

        )

    end


    task.defer(
        function()

            RemoveScroll.CanvasSize =
                UDim2.new(
                    0,
                    0,
                    0,
                    RemoveLayout.AbsoluteContentSize.Y
                )

        end
    )

end


