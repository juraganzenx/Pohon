    --------------------------------------------------

    for _, Child in ipairs(
        HistoryScroll:GetChildren()
    ) do

        if Child:IsA(
            "TextLabel"
        )
        then

            Child:Destroy()

        end

    end


    --------------------------------------------------
    -- CREATE ROW
    --------------------------------------------------

    for Username, Data in pairs(
        History
    ) do

        if type(Data)
            == "table"
        then

            local StatusValue =
                Data.Status
                or "Belum kirim"

            local Value =
                Data.Value
                or 0

            local FruitCount =
