--------------------------------------------------
-- DRAG GUI
--------------------------------------------------

local Dragging =
    false

local DragStart

local StartPosition


Title.InputBegan:Connect(

    function(
        Input
    )

        if Input.UserInputType
            == Enum.UserInputType.MouseButton1
        then

            Dragging =
                true

            DragStart =
                Input.Position

            StartPosition =
                Main.Position

        end

    end

)


Title.InputEnded:Connect(

    function(
        Input
    )

        if Input.UserInputType
            == Enum.UserInputType.MouseButton1
        then

            Dragging =
                false

        end

    end

)


UserInputService.InputChanged:Connect(

    function(
        Input
    )

        if Dragging
            and Input.UserInputType
                == Enum.UserInputType.MouseMovement
        then

            local Delta =
                Input.Position
                - DragStart


            Main.Position =
                UDim2.new(

                    StartPosition.X.Scale,

                    StartPosition.X.Offset
                    + Delta.X,

                    StartPosition.Y.Scale,

                    StartPosition.Y.Offset
                    + Delta.Y

                )

        end

    end

)


