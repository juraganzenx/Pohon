--==================================================
-- FORMAT VALUE
--==================================================

local function FormatValue(Value)

    Value =
        tonumber(Value)
        or 0

    if Value <= 0 then
        return "0"
    end

    local Success, Result =
        pcall(function()

            return NumberUtils.Abbreviate(
                Value
            )

        end)

    if Success then

        return tostring(
            Result
        )

    end

    return tostring(
        Value
    )

end

