--==================================================
-- SEND TO TARGET
--==================================================

local function SendToTarget(
    TargetUsername
)

    SetStep(
        "Getting UserId: " ..
        TargetUsername
    )


    local SuccessUserId,
        TargetUserId =

        pcall(
            function()

                return Players:GetUserIdFromNameAsync(
                    TargetUsername
                )

            end
        )


    if not SuccessUserId
        or not TargetUserId then

        return false

    end


    SetStep(
        "Building Trade Batch"
    )


    local Batch,
        TotalValue =

        BuildBatch()


    if #Batch == 0 then

        return false

    end


    SetStep(

        "Sending " ..

        #Batch ..

        " Fruit -> " ..

        TargetUsername

    )


    local SuccessSend =

        pcall(
            function()

                Networking
                    .Mailbox
                    .SendBatch
                    :Fire(

                        TargetUserId,

                        Batch,

                        NOTE

                    )

            end
        )


    if not SuccessSend then

        return false

    end


    --==================================================
    -- SAVE TRADE HISTORY
    --==================================================

    History[
        TargetUsername
    ] = {

        Status =
            "Sudah kirim",

        Value =
            TotalValue

    }


    SaveHistory()

    RefreshHistoryGUI()


    return true

end


--==================================================
-- AUTO SEND
--==================================================

local function RunAutoSend()

    local TargetUsername =
        GetNextTarget()


    if not TargetUsername then

        SetStep(
            "All Players Sent - Resetting"
        )


        task.wait(
            1
        )


        ResetHistory()


        TargetUsername =
            GetNextTarget()

    end


    if not TargetUsername then

        return

    end


    SetStep(

        "Checking Fruit -> " ..

        TargetUsername

    )


    local FruitCount =
        0


    for _, Item in ipairs(
        Backpack:GetChildren()
    ) do


        if Item:IsA(
            "Tool"
        )
        or Item:IsA(
            "Configuration"
        ) then


            if Item:GetAttribute(
                "FruitName"
            ) then

                FruitCount += 1

            end

        end

    end


    if FruitCount <
        MAX_FRUIT_SEND then

        SetStep(

            "Waiting Fruit: " ..

            FruitCount ..

            "/" ..

            MAX_FRUIT_SEND

        )


        return

    end


    SendToTarget(
        TargetUsername
    )

end


