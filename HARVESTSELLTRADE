-- NORMALIZE HISTORY
--------------------------------------------------

local function NormalizeHistory(
    History
)

    if type(History)
        ~= "table"
    then

        return CreateDefaultHistory()

    end


    --------------------------------------------------
    -- CONVERT OLD FORMAT
    --------------------------------------------------

    for Username, Data in pairs(
        History
    ) do

        if type(Data)
            == "string"
        then

            History[
                Username
            ] = {

                Status =
                    Data,

                Value =
                    0,

                FruitCount =
                    0

            }

        elseif type(Data)
            == "table"
        then

            if Data.Status
                == nil
            then

                Data.Status =
                    "Belum kirim"

            end

            if Data.Value
                == nil
            then

                Data.Value =
                    0

            end

            if Data.FruitCount
                == nil
            then

                Data.FruitCount =
                    0

            end

        end

    end


    --------------------------------------------------
    -- ADD DEFAULT USERNAME
    --------------------------------------------------

    for _, Username in ipairs(
        DEFAULT_USERNAMES
    ) do

        if History[
            Username
        ] == nil
        then

            History[
                Username
            ] = {

                Status =
                    "Belum kirim",

                Value =
                    0,

                FruitCount =
                    0

            }

        end

    end


    return History

end


--------------------------------------------------
-- SAVE HISTORY
--------------------------------------------------

local function SaveHistory(
    History
)

    if not IsFileAPIAvailable() then

        warn(
            "[AUTO SEND] File API tidak tersedia"
        )

        return false

    end


    local Success,
    Error =
        pcall(
            function()

                local JsonData =
                    HttpService:JSONEncode(
                        History
                    )

                writefile(
                    HISTORY_FILE,
                    JsonData
                )

            end
        )


    if not Success then

        warn(
            "[AUTO SEND] Save error:",
            Error
        )

        return false

    end


    CurrentHistory =
        History

    return true

end


--------------------------------------------------
-- LOAD HISTORY
--------------------------------------------------

local function LoadHistory()

    if not IsFileAPIAvailable() then

        return nil

    end


    --------------------------------------------------
    -- FILE NOT EXIST
    --------------------------------------------------

    if not isfile(
        HISTORY_FILE
    ) then

        local NewHistory =
            CreateDefaultHistory()

        SaveHistory(
            NewHistory
        )

        return NewHistory

    end


    --------------------------------------------------
    -- READ
    --------------------------------------------------

    local Success,
    History =
        pcall(
            function()

                local JsonData =
                    readfile(
                        HISTORY_FILE
                    )

                return HttpService:JSONDecode(
                    JsonData
                )

            end
        )


    if not Success
        or type(History)
            ~= "table"
    then

        local NewHistory =
            CreateDefaultHistory()

        SaveHistory(
            NewHistory
        )

        return NewHistory

    end


    History =
        NormalizeHistory(
            History
        )


    SaveHistory(
        History
    )


    return History

end


--------------------------------------------------
-- FORMAT VALUE
--------------------------------------------------

local function FormatValue(
    Value
)

    Value =
        tonumber(
            Value
        ) or 0

    if Value <= 0 then

        return "0"

    end


    local Success,
    Result =
        pcall(
            function()

                return NumberUtils.Abbreviate(
                    Value
                )

            end
        )


    if Success
        and Result
    then

        return tostring(
            Result
        )

    end


    return tostring(
        Value
    )

end


