    for _, Username in ipairs(
        TARGET_USERNAMES
    ) do

        NewHistory[Username] = {

            Status =
                "Belum kirim",

            Value = 0

        }

    end

    return NewHistory

end


--==================================================
-- SAVE HISTORY
--==================================================

local function SaveHistory()

    if not IsFileAPIAvailable() then
        return false
    end

    local Success =
        pcall(
            function()

                writefile(
                    HISTORY_FILE,
                    HttpService:JSONEncode(
                        History
                    )
                )

            end
        )

    return Success

end


--==================================================
-- LOAD HISTORY
--==================================================

local function LoadHistory()

    if not IsFileAPIAvailable() then

        History =
            CreateDefaultHistory()

        return

    end


    if not isfile(
        HISTORY_FILE
    ) then

        History =
            CreateDefaultHistory()

        SaveHistory()

        return

    end


    local Success, Data =
        pcall(
            function()

                return
                    HttpService:JSONDecode(
                        readfile(
                            HISTORY_FILE
                        )
                    )

            end
        )


    if Success
        and type(Data) == "table" then

        History = Data

    else

        History =
            CreateDefaultHistory()

    end


    --==================================================
    -- MIGRATION
    --==================================================

    for _, Username in ipairs(
        TARGET_USERNAMES
    ) do

        if History[Username] == nil then

            History[Username] = {

                Status =
                    "Belum kirim",

                Value = 0

            }

        elseif
            type(
                History[Username]
            ) == "string"
        then

            History[Username] = {

                Status =
                    History[Username],

                Value = 0

            }

        end

    end


    SaveHistory()

end


